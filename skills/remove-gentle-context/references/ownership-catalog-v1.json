  "ownership_authority": {
    "issue": "https://github.com/pablontiv/skills/issues/1",
    "adr_path": "docs/adr/0001-portable-skill-ownership-and-provenance.md",
    "authority_commit": "913bcde"
  },
  "canonical_metadata": {
    "required_string_fields": ["author", "created", "updated", "version"],
    "author": "pablontiv",
    "adapted_required_string_fields": ["upstream-author", "upstream-repository", "upstream-commit", "ownership"],
    "adapted_ownership": "personal"
  },
  "adapted_skill_provenance": {
    "systemic-issue-triage": {
      "upstream-author": "Alan-TheGentleman",
      "upstream-repository": "https://github.com/Gentleman-Programming/gentle-ai",
      "upstream-commit": "d1e1777faafc91a34656ba94bd712972dbe427a1",
      "license": "Apache-2.0"
    }
  },
  "personal_skill_releases": {},
  "receipt_minimum_fields": [
    "skill_name",
    "skill_version",
    "personal_source_repository",
    "personal_source_commit",
    "installed_path",
    "installed_content_sha256",
    "installation_timestamp",
    "canonical_tree_sha256"
  ],
  "preserved_requires": [
    "metadata.author=pablontiv",
    "complete_adapted_metadata",
    "matching_installation_receipt",
    "trusted_personal_skill_release",
    "receipt.personal_source_commit=release.personal_source_commit",
    "receipt.canonical_tree_sha256=release.canonical_tree_sha256",
    "actual_installed_content_sha256=receipt.installed_content_sha256",
    "actual_installed_tree_sha256=release.canonical_tree_sha256"
  ],
  "ownership_policy": {
    "author_pablontiv_auto_deletion_veto": true,
    "author_without_complete_evidence": "ambiguous",
    "missing_release_or_provenance": "ambiguous",
    "name_path_comment_marker_or_author_alone_proves_personal_ownership": false,
    "exact_file_discovers_only_without_corroboration": true
  }
